msgid "Register"
msgstr "رجسٹر کریں"

msgid "Packing can be changed by the Shipper at this stage."
msgstr "اس مرحلے پر پیکنگ شپر تبدیل کر سکتا ہے۔"

msgid "Packing can be changed by the Receiver at this stage."
msgstr "اس مرحلے پر پیکنگ ریسیور تبدیل کر سکتا ہے۔"

msgid ""
"Packing is locked while the goods are in transit or the consignment is "
"closed."
msgstr "سامان راستے میں ہو یا کنسائنمنٹ بند ہو تو پیکنگ لاک رہتی ہے۔"

msgid "Items not inside any unit"
msgstr "وہ آئٹمز جو کسی یونٹ میں نہیں"

msgid ""
"Receiving opens when the consignment has arrived. Until then this page shows"
" what is expected."
msgstr ""
"کنسائنمنٹ پہنچنے پر وصولی شروع ہوتی ہے۔ تب تک یہ صفحہ متوقع سامان دکھاتا ہے۔"

msgid "units and items"
msgstr "یونٹس اور آئٹمز"

msgid "Not yet received"
msgstr "ابھی وصول نہیں ہوا"

msgid "Scan to receive"
msgstr "وصولی کے لیے اسکین"

msgid "Units"
msgstr "یونٹس"

msgid "Everything has been received."
msgstr "سب کچھ وصول ہو چکا ہے۔"

msgid ""
"Raise a “Damage” remark from the unit or item page so the Shipper can "
"respond (and claim insurance)."
msgstr ""
"یونٹ یا آئٹم کے صفحے سے “نقصان” کا ریمارک درج کریں تاکہ شپر جواب دے سکے (اور"
" انشورنس کلیم کر سکے)۔"

msgid "No damage recorded."
msgstr "کوئی نقصان درج نہیں۔"

msgid ""
"Read-only view of the underlying data. Export any table to Excel (CSV)."
msgstr ""
"بنیادی ڈیٹا کا صرف دیکھنے والا منظر۔ کوئی بھی ٹیبل Excel (CSV) میں ایکسپورٹ "
"کریں۔"

msgid "Tables"
msgstr "ٹیبلز"

msgid "Filter"
msgstr "فلٹر"

msgid "Export CSV"
msgstr "CSV ایکسپورٹ"

#, python-format
msgid "%(n)s rows"
msgstr "%(n)s سطریں"

msgid "No rows."
msgstr "کوئی سطر نہیں۔"

msgid "Previous"
msgstr "پچھلا"

#, python-format
msgid "Page %(p)s of %(n)s"
msgstr "صفحہ %(p)s از %(n)s"

msgid "Next"
msgstr "اگلا"

msgid ""
"Use the phone camera, a USB/Bluetooth barcode scanner, or type an ID. The QR"
" label contains the full ID; a manufacturer serial no. also works."
msgstr ""
"فون کیمرا، USB/بلوٹوتھ بارکوڈ اسکینر استعمال کریں یا ID لکھیں۔ QR لیبل میں "
"مکمل ID ہے؛ مینوفیکچرر سیریل نمبر بھی چلتا ہے۔"

#, python-format
msgid "Short IDs (CTN-017, DCJM-017) are looked up in %(c)s"
msgstr "مختصر IDs (CTN-017، DCJM-017) کو %(c)s میں تلاش کیا جاتا ہے"

msgid ""
"No destination yet: scan the container, pallet or carton to move things "
"into."
msgstr ""
"ابھی منزل نہیں: وہ کنٹینر، پیلیٹ یا کارٹن اسکین کریں جس میں چیزیں منتقل کرنی"
" ہیں۔"

msgid "Destination"
msgstr "منزل"

msgid ""
"The camera could not be started. Check the browser permission, or type/scan "
"the ID instead."
msgstr ""
"کیمرا شروع نہیں ہو سکا۔ براؤزر کی اجازت چیک کریں، یا ID لکھیں/اسکین کریں۔"

msgid "The camera needs a secure (https) connection."
msgstr "کیمرے کے لیے محفوظ (https) کنکشن درکار ہے۔"

msgid "Connection problem: the scan was not saved. Try again."
msgstr "کنکشن کا مسئلہ: اسکین محفوظ نہیں ہوا۔ دوبارہ کوشش کریں۔"

msgid "What do you want to do?"
msgstr "آپ کیا کرنا چاہتے ہیں؟"

msgid "Look up"
msgstr "تلاش"

msgid "Move / repack"
msgstr "منتقل / دوبارہ پیک"

msgid "Receive"
msgstr "وصول کریں"

msgid "Change destination"
msgstr "منزل تبدیل کریں"

msgid "Scan or type an ID, then press Enter"
msgstr "ID اسکین کریں یا لکھیں، پھر Enter دبائیں"

msgid "Use camera"
msgstr "کیمرا استعمال کریں"

msgid "Results"
msgstr "نتائج"

msgid "Scanned IDs appear here."
msgstr "اسکین شدہ IDs یہاں ظاہر ہوں گی۔"

msgid "Mark resolved"
msgstr "حل شدہ قرار دیں"

msgid "Reopen"
msgstr "دوبارہ کھولیں"

msgid "About"
msgstr "متعلقہ"

#, python-format
msgid "Waiting for: %(p)s"
msgstr "منتظر: %(p)s"

msgid "How it works"
msgstr "یہ کیسے کام کرتا ہے"

msgid "Open: waiting for the other party to answer."
msgstr "کھلا: دوسرے فریق کے جواب کا انتظار۔"

msgid "Answered: waiting for the party who raised it to accept or follow up."
msgstr "جواب دیا گیا: درج کرنے والے فریق کی منظوری یا مزید سوال کا انتظار۔"

msgid "Resolved: closed by the party who raised it. Anyone can reopen it."
msgstr ""
"حل شدہ: درج کرنے والے فریق نے بند کیا۔ کوئی بھی اسے دوبارہ کھول سکتا ہے۔"

msgid "Machine translations help reading; the original text is what counts."
msgstr "مشینی ترجمہ پڑھنے میں مدد کے لیے ہے؛ اصل متن ہی معتبر ہے۔"

msgid "raised by"
msgstr "درج کنندہ"

msgid "Nothing here."
msgstr "یہاں کچھ نہیں۔"

msgid "Raise a remark or query"
msgstr "ریمارک یا سوال درج کریں"

msgid ""
"Write in your own language. The other side reads it in theirs; the original "
"is always kept."
msgstr ""
"اپنی زبان میں لکھیں۔ دوسرا فریق اپنی زبان میں پڑھے گا؛ اصل متن ہمیشہ محفوظ "
"رہتا ہے۔"

msgid "Post"
msgstr "پوسٹ کریں"

msgid "Seal"
msgstr "سیل"

msgid "Labels for contents"
msgstr "اندر کے سامان کے لیبل"

msgid "Contents"
msgstr "مواد"

msgid "Units inside"
msgstr "اندر یونٹس"

msgid "Qty"
msgstr "مقدار"

msgid "Dimensions"
msgstr "پیمائش"

msgid "Gross weight"
msgstr "مجموعی وزن"

msgid "Marks"
msgstr "نشانات"

msgid "Remarks about this unit"
msgstr "اس یونٹ کے بارے میں ریمارکس"
