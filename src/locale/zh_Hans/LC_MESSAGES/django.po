msgid "Two-factor authentication was reset for %(name)s."
msgstr "已为 %(name)s 重置双重验证。"

#, python-format
msgid "%(name)s can no longer sign in. Their history is kept."
msgstr "%(name)s 已无法登录，其历史记录仍会保留。"

