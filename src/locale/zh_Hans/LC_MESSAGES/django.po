#, python-format
msgid "%(doc)s for %(code)s is due. Please upload it."
msgstr "%(code)s 的%(doc)s已到期，请上传。"

#, python-format
msgid "Reminder: %(doc)s for %(code)s is %(days)s day(s) overdue."
msgstr "提醒：%(code)s 的%(doc)s已逾期 %(days)s 天。"

#, python-format
msgid ""
"Escalation: %(doc)s for %(code)s is %(days)s day(s) overdue. Responsible: "
"%(org)s."
msgstr "升级提醒：%(code)s 的%(doc)s已逾期 %(days)s 天。负责方：%(org)s。"

#, python-format
msgid "%(user)s uploaded %(doc)s (version %(version)s) for %(code)s."
msgstr "%(user)s 为 %(code)s 上传了%(doc)s（第 %(version)s 版）。"

#, python-format
msgid "%(user)s raised a %(category)s on %(code)s: %(subject)s"
msgstr "%(user)s 在 %(code)s 上提出了%(category)s：%(subject)s"

#, python-format
msgid "%(user)s replied on %(code)s: %(subject)s"
msgstr "%(user)s 在 %(code)s 上回复了：%(subject)s"

#, python-format
msgid "%(user)s marked “%(subject)s” on %(code)s as %(state)s."
msgstr "%(user)s 将 %(code)s 的“%(subject)s”标记为%(state)s。"

#, python-format
msgid "%(code)s is now: %(status)s."
msgstr "%(code)s 当前状态：%(status)s。"

#, python-format
msgid "%(user)s added a required document to %(code)s: %(doc)s."
msgstr "%(user)s 为 %(code)s 添加了必需单据：%(doc)s。"

#, python-format
msgid "%(user)s tagged %(code)s: %(tag)s. %(note)s"
msgstr "%(user)s 为 %(code)s 添加了标签：%(tag)s。%(note)s"

#, python-format
msgid "%(user)s removed the tag “%(tag)s” from %(code)s."
msgstr "%(user)s 移除了 %(code)s 的标签“%(tag)s”。"

#, python-format
msgid "Status update on %(code)s from %(user)s: %(note)s"
msgstr "%(user)s 发布了 %(code)s 的状态更新：%(note)s"

