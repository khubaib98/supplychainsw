msgstr "失败次数过多，请 15 分钟后再试。"

msgid "That code is not valid. Check the time on your phone and try again."
msgstr "验证码无效。请检查手机时间后重试。"

msgid ""
"This administrator account has no organisation profile. Use the admin site."
msgstr "该管理员账号没有组织资料，请使用管理后台。"

msgid "Preferences saved."
msgstr "偏好设置已保存。"

msgid "That code is not valid."
msgstr "验证码无效。"

msgid "Two-factor authentication is mandatory on this portal."
msgstr "本平台必须启用双重验证。"

msgid "Two-factor authentication is now off."
msgstr "双重验证已关闭。"

msgid "Two-factor authentication is on. You will need a code at every login."
msgstr "双重验证已开启。每次登录都需要验证码。"

msgid "Password changed."
msgstr "密码已修改。"

