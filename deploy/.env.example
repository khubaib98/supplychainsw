# Copy to .env and fill in. Never commit the real .env.
# Generate secrets with:  openssl rand -hex 32   (hex keeps them URL-safe)

# --- Web address ---------------------------------------------------------
PORTAL_DOMAIN=portal.example.com
PORTAL_BASE_URL=https://portal.example.com
DJANGO_ALLOWED_HOSTS=portal.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.com

# --- Secrets ---------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-openssl-rand-hex-32
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# --- Behaviour -------------------------------------------------------------
PORTAL_NAME=CN–PK Consignment Portal
PORTAL_CONSIGNMENT_PREFIX=CSG
# Reminder ladder in days after the due date: 1st reminder, 2nd reminder, escalation to Oversight
PORTAL_REMINDER_DAYS=0,2,5
# Everyone must set up an authenticator app at first login
PORTAL_REQUIRE_2FA=1
PORTAL_UPLOAD_MAX_MB=25
GUNICORN_WORKERS=3

# --- E-mail (reminders) ----------------------------------------------------
# Use a provider with good delivery to both Chinese (QQ/163/corporate) and Pakistani mailboxes,
# and set SPF/DKIM/DMARC for the sending domain.
PORTAL_FROM_EMAIL=portal@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1

# --- Machine translation of remarks (UI translation needs none of this) ---------
# none | libretranslate | anthropic
MT_PROVIDER=none
LIBRETRANSLATE_URL=http://libretranslate:5000
# For MT_PROVIDER=anthropic (Claude API); comment text is sent to Anthropic for translation.
ANTHROPIC_API_KEY=
MT_ANTHROPIC_MODEL=claude-opus-5-5

# --- Virus scanning of uploads (with `--profile antivirus`) -------------------
# PORTAL_CLAMAV=clamav:3310

# --- Backups ---------------------------------------------------------------
BACKUP_KEEP_DAYS=14
# Strongly recommended: encrypts every backup file (keep this passphrase somewhere safe, offline!)
BACKUP_PASSPHRASE=
# Optional off-site copy via rclone (configure deploy/rclone/rclone.conf), e.g. pk-nas:portal-backups
RCLONE_REMOTE=
